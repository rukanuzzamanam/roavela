# ─────────────────────────────────────────────────────────────
# Roavela environment variables
# Copy to `.env` for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, emails, OpenGraph).
APP_URL="http://localhost:3000"

# PostgreSQL connection string (required).
# Local option without installing Postgres: `npx prisma dev` prints a TCP URL like the one below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roavela?sslmode=disable"
# Optional: separate shadow database used by `prisma migrate dev`.
# SHADOW_DATABASE_URL=""
# Optional connection-pool tuning (driver defaults when unset).
# With `prisma dev`, set DATABASE_IDLE_TIMEOUT_MS=1 — it drops idle connections, which otherwise
# surfaces as "Server has closed the connection" errors.
# DATABASE_POOL_MAX="10"
# DATABASE_IDLE_TIMEOUT_MS=""

# Secret used for signing/HMAC operations (32+ random chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Show seeded demo listings in production builds. Demo data is always visible in development.
SHOW_DEMO_LISTINGS="false"

# ── Maps (optional) ──────────────────────────────────────────
# Without a token a schematic map fallback is rendered. Mapbox public tokens (pk.*) are browser-safe.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── Routing (optional, later phase) ──────────────────────────
# "heuristic" (default, no key needed) | "mapbox"
ROUTING_PROVIDER="heuristic"

# ── Payments (later phase) — Stripe TEST MODE ONLY for the MVP ──
# Without these a mock payment provider is used.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Image storage (later phase) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (optional) ─────────────────────────────────────────
# Without a key, emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Roavela <hello@example.com>"

# ── AI trip planner (later phase) ────────────────────────────
# "mock" (default) | provider name once implemented
AI_PROVIDER="mock"
AI_API_KEY=""

# ── Analytics (optional) ─────────────────────────────────────
# "console" (default in development) | "none"
ANALYTICS_PROVIDER="console"

# ── Seed (development only) ─────────────────────────────────
# Password for seeded demo accounts. If empty, a random one is generated and printed.
SEED_DEMO_PASSWORD=""
# Required to seed demo data when NODE_ENV=production (not recommended).
# ALLOW_DEMO_SEED="false"
