# ─────────────────────────────────────────────────────────────
# Roavela environment variables
# Copy to `.env` for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, emails, OpenGraph).
APP_URL="http://localhost:3000"

# PostgreSQL connection string (required).
# Local option without installing Postgres: `npx prisma dev` prints a TCP URL like the one below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roavela?sslmode=disable"
# Optional: separate shadow database used by `prisma migrate dev`.
# SHADOW_DATABASE_URL=""
# Optional connection-pool tuning (driver defaults when unset).
# With `prisma dev`, set DATABASE_IDLE_TIMEOUT_MS=1 — it drops idle connections, which otherwise
# surfaces as "Server has closed the connection" errors.
# DATABASE_POOL_MAX="10"
# DATABASE_IDLE_TIMEOUT_MS=""

# Secret used for signing/HMAC operations (32+ random chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Show seeded demo listings in production builds. Demo data is always visible in development.
SHOW_DEMO_LISTINGS="false"

# ── Maps (optional) ──────────────────────────────────────────
# "fallback" (default: schematic map, no key needed) | "mapbox" | "google".
# Only the fallback is implemented today; other values (or a missing key) fall back safely.
MAP_PROVIDER="fallback"
# Browser-exposed map keys — use restricted, public keys only (Mapbox pk.*, referrer-restricted Google key).
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ── Routing (optional) ───────────────────────────────────────
# "heuristic" is the only implementation today (no key needed; drive times shown as estimates).
ROUTING_PROVIDER="heuristic"

# ── Payments (later phase) — Stripe TEST MODE ONLY for the MVP ──
# Without these a mock payment provider is used.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── File storage (host photos, avatars, compliance documents) ──
# "local" is the only adapter today: files go to STORAGE_LOCAL_DIR (gitignored).
# Local storage is refused in production unless STORAGE_LOCAL_ALLOW_PRODUCTION="true" — it isn't
# durable or shared between instances. Add a Cloudinary/S3 adapter before launch.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".data/uploads"
STORAGE_LOCAL_ALLOW_PRODUCTION="false"
# Future Cloudinary adapter (server-side only — never NEXT_PUBLIC_).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (optional) ─────────────────────────────────────────
# With a Resend key, transactional email (e.g. password reset) is sent via Resend.
# Without one, emails are printed to the server console in development only (subject/domain only
# in production) — so the password-reset flow can be tested locally.
RESEND_API_KEY=""
# Must be a sender on a domain verified with your email provider.
EMAIL_FROM="Roavela <hello@example.com>"

# ── Password reset ───────────────────────────────────────────
# Reset-link lifetime in minutes (5–1440). Links are single-use.
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

# ── AI trip planner (later phase) ────────────────────────────
# "mock" (default) | provider name once implemented
AI_PROVIDER="mock"
AI_API_KEY=""

# ── Analytics (optional) ─────────────────────────────────────
# "console" (default in development) | "none"
ANALYTICS_PROVIDER="console"

# ── Seed (development only) ─────────────────────────────────
# Password for seeded demo accounts. If empty, a random one is generated and printed.
SEED_DEMO_PASSWORD=""
# Required to seed demo data when NODE_ENV=production (not recommended).
# ALLOW_DEMO_SEED="false"
